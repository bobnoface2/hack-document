{
  "id": "curriculum-classico-executivo",
  "name": "Currículo Clássico Executivo (Serif)",
  "type": "documento",
  "category": "recrutamento_selecao",
  "format": "html",
  "content": "<div class=\"p-8 max-w-4xl mx-auto bg-white text-neutral-900 font-serif leading-relaxed\">\n  <div class=\"text-center border-b-2 border-neutral-750 pb-4 mb-6\">\n    <h1 class=\"text-3xl font-black uppercase tracking-wide\">{{nome_completo}}</h1>\n    <p class=\"text-sm italic font-sans text-neutral-600 mt-1\">{{cargo_principal}}</p>\n    <p class=\"text-xs font-sans text-neutral-500 mt-2\">\n      {{cidade_estado}} &bull; Celular: {{telefone}} &bull; E-mail: {{email}} &bull; LinkedIn: {{linkedin}}\n    </p>\n  </div>\n\n  <div class=\"space-y-6\">\n    <div>\n      <h2 class=\"text-base font-bold uppercase tracking-wider text-neutral-850 font-sans border-b border-neutral-350 pb-0.5 mb-2\">Resumo Profissional</h2>\n      <p class=\"text-xs text-neutral-750 text-justify\">{{resumo_profissional}}</p>\n    </div>\n\n    <div>\n      <h2 class=\"text-base font-bold uppercase tracking-wider text-neutral-850 font-sans border-b border-neutral-350 pb-0.5 mb-3\">Histórico Profissional</h2>\n      \n      <div class=\"space-y-4\">\n        <div>\n          <div class=\"flex justify-between items-baseline font-sans text-xs font-bold text-neutral-900\">\n            <span>{{experiencia_1_cargo}}</span>\n            <span class=\"font-normal text-neutral-500 italic\">{{experiencia_1_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-neutral-600 italic mb-1\">{{experiencia_1_empresa}}</div>\n          <p class=\"text-xs text-neutral-700 text-justify\">{{experiencia_1_descricao}}</p>\n        </div>\n\n        <div>\n          <div class=\"flex justify-between items-baseline font-sans text-xs font-bold text-neutral-900\">\n            <span>{{experiencia_2_cargo}}</span>\n            <span class=\"font-normal text-neutral-500 italic\">{{experiencia_2_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-neutral-600 italic mb-1\">{{experiencia_2_empresa}}</div>\n          <p class=\"text-xs text-neutral-700 text-justify\">{{experiencia_2_descricao}}</p>\n        </div>\n      </div>\n    </div>\n\n    <div>\n      <h2 class=\"text-base font-bold uppercase tracking-wider text-neutral-850 font-sans border-b border-neutral-350 pb-0.5 mb-2\">Formação Acadêmica</h2>\n      <div class=\"flex justify-between items-baseline font-sans text-xs\">\n        <div>\n          <strong class=\"text-neutral-900\">{{formacao_1_curso}}</strong>\n          <span class=\"text-neutral-600\"> &mdash; {{formacao_1_instituicao}}</span>\n        </div>\n        <span class=\"text-neutral-500 italic\">{{formacao_1_periodo}}</span>\n      </div>\n    </div>\n\n    <div>\n      <h2 class=\"text-base font-bold uppercase tracking-wider text-neutral-850 font-sans border-b border-neutral-350 pb-0.5 mb-2\">Competências & Idiomas</h2>\n      <p class=\"text-xs text-neutral-750\">\n        <strong>Principais Habilidades:</strong> {{habilidades}}<br class=\"my-1\" />\n        <strong>Idiomas:</strong> {{idiomas}}\n      </p>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
  "updatedAt": "2026-06-22T00:00:00.000Z"
}