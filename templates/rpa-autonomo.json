{
  "id": "rpa-autonomo",
  "name": "Recibo de Pagamento de Autônomo (RPA S/A)",
  "type": "recibo",
  "category": "financeiro",
  "format": "html",
  "content": "<div class=\"p-10 font-sans max-w-3xl mx-auto border border-neutral-300 rounded-xl bg-white shadow-sm\">\n  <div class=\"text-center border-b-2 border-neutral-800 pb-6 mb-8\">\n    <h1 class=\"text-xl font-bold uppercase tracking-tight\">RECIBO DE PAGAMENTO DE AUTÔNOMO - RPA</h1>\n    <p class=\"text-[10px] text-neutral-500 font-mono mt-1\">CONTROLADO SOB O NÚMERO DE SISTEMA: #{{rpa_numero}}</p>\n  </div>\n\n  <div class=\"space-y-6 text-xs text-neutral-800\">\n    <!-- Fonte Pagadora -->\n    <div class=\"border border-neutral-200 p-4 rounded-xl space-y-2 bg-neutral-50/50\">\n      <span class=\"text-[9px] font-mono text-neutral-400 block uppercase\">1. Fonte Pagadora (Contratante)</span>\n      <p><strong>Nome/Razão Social:</strong> {{fonte_pagadora_nome}}</p>\n      <p><strong>CGC / CNPJ:</strong> <span class=\"font-mono\">{{fonte_pagadora_cnpj}}</span></p>\n    </div>\n\n    <!-- Profissional Autonómo -->\n    <div class=\"border border-neutral-200 p-4 rounded-xl space-y-2 bg-neutral-50/50\">\n      <span class=\"text-[9px] font-mono text-neutral-400 block uppercase\">2. Profissional Autônomo Credenciado</span>\n      <div class=\"grid grid-cols-2 gap-4\">\n        <p><strong>Nome Completo:</strong> {{profissional_nome}}</p>\n        <p><strong>CPF nº:</strong> <span class=\"font-mono\">{{profissional_cpf}}</span></p>\n        <p><strong>Nº Inscrição (INSS/PIS):</strong> <span class=\"font-mono\">{{profissional_inss}}</span></p>\n        <p><strong>Cidade/UF:</strong> <span>{{profissional_cidade_uf}}</span></p>\n      </div>\n    </div>\n\n    <!-- Descricao dos Servicos -->\n    <div class=\"border border-neutral-200 p-4 rounded-xl space-y-2\">\n      <span class=\"text-[9px] font-mono text-neutral-400 block uppercase\">3. Especificação dos Serviços Prestados</span>\n      <p class=\"italic leading-relaxed text-neutral-700 bg-neutral-50 p-2.5 rounded font-mono\">{{servicos_prestados_especificacao}}</p>\n    </div>\n\n    <!-- Demonstrativo de Valores -->\n    <div class=\"border border-neutral-200 rounded-xl overflow-hidden\">\n      <div class=\"bg-neutral-800 text-white font-mono text-[9px] uppercase tracking-wider px-3 py-1.5 font-bold\">4. Demonstrativo Financeiro de Desconto & Tributação</div>\n      <table class=\"w-full text-left text-xs font-mono border-collapse\">\n        <tbody>\n          <tr class=\"border-b border-neutral-200\">\n            <td class=\"p-2.5 font-semibold bg-neutral-50\">Específico Valor Bruto do Serviço (A)</td>\n            <td class=\"p-2.5 text-right font-bold text-neutral-900\">R$ {{valor_bruto}}</td>\n          </tr>\n          <tr class=\"border-b border-neutral-200\">\n            <td class=\"p-2.5 text-neutral-600\">(-) Desconto Retenção de INSS (11%)</td>\n            <td class=\"p-2.5 text-right font-bold text-red-600\">- R$ {{desconto_inss}}</td>\n          </tr>\n          <tr class=\"border-b border-neutral-200\">\n            <td class=\"p-2.5 text-neutral-600\">(-) Desconto Retenção de IRRF (S/ Tabela)</td>\n            <td class=\"p-2.5 text-right font-bold text-red-600\">- R$ {{desconto_irrf}}</td>\n          </tr>\n          <tr class=\"border-b border-neutral-200\">\n            <td class=\"p-2.5 text-neutral-600\">(-) Desconto ISSQN Municipal (S/ Alíquota do Município)</td>\n            <td class=\"p-2.5 text-right font-bold text-red-600\">- R$ {{desconto_iss}}</td>\n          </tr>\n          <tr class=\"bg-neutral-900 text-white\">\n            <td class=\"p-3 font-bold uppercase text-[10px] text-neutral-300\">= VALOR LÍQUIDO A SER PAGO (LÍQUIDO RECEBER)</td>\n            <td class=\"p-3 text-right font-black text-[#39FF14] text-sm\">R$ {{valor_liquido}}</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <!-- Declaracao de Recebimento -->\n    <div class=\"p-4 bg-neutral-50 border border-neutral-200 rounded-xl leading-relaxed text-neutral-600\">\n      Declaramos, para os devidos fins de direito operacionais, que recebi da fonte pagadora acima especificada a líquida quantia líquida descrita no demonstrativo financeiro deste recibo, dando plena, geral e irrevogável quitação sob o serviço individual prestado em <span class=\"font-bold font-mono text-neutral-900\">{{data_pagamento}}</span>.\n    </div>\n  </div>\n\n  <!-- Assinatura -->\n  <div class=\"flex justify-between items-center mt-12 text-xs\">\n    <div>\n      <p class=\"text-neutral-400 font-mono text-[9px] uppercase\">Data da Liquidação</p>\n      <strong class=\"font-mono\">{{data_pagamento}}</strong>\n    </div>\n    <div class=\"text-center space-y-2\">\n      <div class=\"border-t border-neutral-800 w-64\"></div>\n      <p class=\"font-bold uppercase text-[9px] font-mono tracking-widest text-neutral-800\">Assinatura do Profissional Autônomo</p>\n      <p class=\"text-[9px] text-neutral-400 font-mono\">CPF: {{profissional_cpf}}</p>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-17T00:00:00.000Z",
  "updatedAt": "2026-06-17T00:00:00.000Z"
}
