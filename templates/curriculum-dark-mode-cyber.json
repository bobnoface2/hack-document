rong class=\"text-xs text-white\">_ { {{experiencia_2_cargo}} }</strong>\n            <span class=\"text-[10px] text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded\">{{experiencia_2_periodo}}</span>\n          </div>\n          <p class=\"text-[10px] text-slate-500 font-bold mb-1.5\">ORGANIZAÇÃO: {{experiencia_2_empresa}}</p>\n          <p class=\"text-xs text-slate-450 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 border-t border-emerald-500/10 pt-6\">\n      <div>\n        <h2 class=\"text-[11px] font-bold uppercase text-emerald-400 mb-2\">[03] FORMACAO</h2>\n        <p class=\"text-xs text-white font-bold\">{{formacao_1_curso}}</p>\n        <p class=\"text-[10px] text-slate-550\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[9px] text-slate-500 mt-1\">{{formacao_1_periodo}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-[11px] font-bold uppercase text-emerald-400 mb-2\">[04] STACK_TEC</h2>\n        <p class=\"text-xs text-slate-400 leading-normal\">{{habilidades}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-[11px] font-bold uppercase text-emerald-400 mb-2\">[05] IDIOMAS</h2>\n        <p class=\"text-xs text-slate-400\">{{idiomas}}</p>\n      </div>\n    </div>\n  </div>\n</div>",
