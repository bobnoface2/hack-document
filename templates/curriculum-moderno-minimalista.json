  "content": "<div class=\"p-8 max-w-4xl mx-auto bg-slate-50 text-slate-800 font-sans leading-relaxed\">\n  <div class=\"flex flex-col md:flex-row md:justify-between md:items-start gap-4 border-b border-indigo-200 pb-5 mb-5\">\n    <div>\n      <h1 class=\"text-3xl font-extrabold text-indigo-950 tracking-tight\">{{nome_completo}}</h1>\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-indigo-600 mt-1.5\">{{cargo_principal}}</p>\n    </div>\n    <div class=\"text-xs text-slate-500 font-medium space-y-0.5 md:text-right\">\n      <p>📍 {{cidade_estado}}</p>\n      <p>📞 {{telefone}}</p>\n      <p>✉️ {{email}}</p>\n      <p>🔗 {{linkedin}}</p>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n    <div class=\"md:col-span-2 space-y-5\">\n      <div>\n        <h2 class=\"text-sm font-bold uppercase tracking-wider text-indigo-900 border-l-4 border-indigo-500 pl-2 mb-2\">Resumo Profissional</h2>\n        <p class=\"text-xs text-slate-650 leading-relaxed text-justify\">{{resumo_profissional}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-sm font-bold uppercase tracking-wider text-indigo-900 border-l-4 border-indigo-500 pl-2 mb-3\">Histórico de Trabalho</h2>\n        \n        <div class=\"space-y-4\">\n          <div class=\"relative pl-4 border-l-2 border-indigo-100\">\n            <div class=\"absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-indigo-500\"></div>\n            <div class=\"flex justify-between items-baseline mb-0.5\">\n              <strong class=\"text-xs text-slate-900 font-bold\">{{experiencia_1_cargo}}</strong>\n              <span class=\"text-[10px] font-mono text-indigo-550 bg-indigo-50 px-1.5 py-0.5 rounded\">{{experiencia_1_periodo}}</span>\n            </div>\n            <div class=\"text-[11px] font-semibold text-indigo-700 mb-1\">{{experiencia_1_empresa}}</div>\n            <p class=\"text-xs text-slate-600 text-justify\">{{experiencia_1_descricao}}</p>\n          </div>\n\n          <div class=\"relative pl-4 border-l-2 border-indigo-100\">\n            <div class=\"absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-indigo-500\"></div>\n            <div class=\"flex justify-between items-baseline mb-0.5\">\n              <strong class=\"text-xs text-slate-900 font-bold\">{{experiencia_2_cargo}}</strong>\n              <span class=\"text-[10px] font-mono text-indigo-550 bg-indigo-50 px-1.5 py-0.5 rounded\">{{experiencia_2_periodo}}</span>\n            </div>\n            <div class=\"text-[11px] font-semibold text-indigo-700 mb-1\">{{experiencia_2_empresa}}</div>\n            <p class=\"text-xs text-slate-600 text-justify\">{{experiencia_2_descricao}}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"space-y-5 bg-white p-4 rounded-xl border border-slate-200\">\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-indigo-900 mb-2 border-b border-indigo-100 pb-1\">Educação</h2>\n        <p class=\"text-xs font-bold text-slate-800\">{{formacao_1_curso}}</p>\n        <p class=\"text-[11px] text-slate-600\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[10px] text-indigo-500 font-mono mt-0.5\">{{formacao_1_periodo}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-indigo-900 mb-2 border-b border-indigo-100 pb-1\">Habilidades</h2>\n        <div class=\"flex flex-wrap gap-1 mt-1.5\">\n          <span class=\"text-[9px] bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded border border-indigo-100 font-medium\">{{habilidades}}</span>\n        </div>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-indigo-900 mb-1 border-b border-indigo-100 pb-1\">Idiomas</h2>\n        <p class=\"text-xs text-slate-700 font-medium mt-1\">{{idiomas}}</p>\n      </div>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
  "updatedAt": "2026-06-22T00:00:00.000Z"
