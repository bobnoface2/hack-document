  "type": "documento",
  "category": "recrutamento_selecao",
  "format": "html",
  "content": "<div class=\"p-6 max-w-4xl mx-auto bg-[#0a0a0c] text-neutral-300 font-sans leading-relaxed\">\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-4\">\n    <div class=\"md:col-span-2 p-5 bg-[#121216] border border-neutral-800 rounded-2xl flex flex-col justify-between\">\n      <div>\n        <h1 class=\"text-3xl font-black tracking-tight text-white uppercase\">{{nome_completo}}</h1>\n        <p class=\"text-xs font-semibold text-[#39FF14] tracking-widest uppercase font-mono mt-1\">{{cargo_principal}}</p>\n      </div>\n      <p class=\"text-xs text-neutral-400 mt-4 text-justify\">{{resumo_profissional}}</p>\n    </div>\n    \n    <div class=\"p-5 bg-gradient-to-br from-[#181824] to-[#121216] border border-neutral-800 rounded-2xl flex flex-col justify-between\">\n      <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-2\">Conexão S/A</h2>\n      <div class=\"space-y-1 text-xs font-mono text-neutral-400\">\n        <p>📍 {{cidade_estado}}</p>\n        <p>📱 {{telefone}}</p>\n        <p>✉️ {{email}}</p>\n        <p class=\"text-[#39FF14]\">🔗 {{linkedin}}</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n    <div class=\"md:col-span-2 space-y-4\">\n      <div class=\"p-5 bg-[#121216] border border-neutral-800 rounded-2xl\">\n        <h2 class=\"text-sm font-bold uppercase tracking-wider text-white border-b border-neutral-800 pb-2 mb-4 flex items-center gap-2\"><span class=\"w-1.5 h-1.5 bg-[#39FF14] rounded-full\"></span> Experiência Profissional</h2>\n        \n        <div class=\"space-y-4\">\n          <div>\n            <div class=\"flex justify-between items-baseline mb-0.5\">\n              <strong class=\"text-xs font-extrabold text-white\">{{experiencia_1_cargo}}</strong>\n              <span class=\"text-[9px] font-mono text-[#39FF14] bg-[#39FF14]/10 px-2 py-0.5 rounded-md\">{{experiencia_1_periodo}}</span>\n            </div>\n            <p class=\"text-[10px] text-neutral-400 font-bold mb-1.5\">{{experiencia_1_empresa}}</p>\n            <p class=\"text-xs text-neutral-500 leading-relaxed text-justify\">{{experiencia_1_descricao}}</p>\n          </div>\n\n          <div class=\"border-t border-[#1a1a22] pt-4\">\n            <div class=\"flex justify-between items-baseline mb-0.5\">\n              <strong class=\"text-xs font-extrabold text-white\">{{experiencia_2_cargo}}</strong>\n              <span class=\"text-[9px] font-mono text-[#39FF14] bg-[#39FF14]/10 px-2 py-0.5 rounded-md\">{{experiencia_2_periodo}}</span>\n            </div>\n            <p class=\"text-[10px] text-neutral-400 font-bold mb-1.5\">{{experiencia_2_empresa}}</p>\n            <p class=\"text-xs text-neutral-500 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"space-y-4\">\n      <div class=\"p-5 bg-[#121216] border border-neutral-800 rounded-2xl\">\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-2\">_Educação</h2>\n        <strong class=\"text-xs text-white block\">{{formacao_1_curso}}</strong>\n        <p class=\"text-[10px] text-neutral-400\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[9px] text-[#39FF14] font-mono mt-1\">{{formacao_1_periodo}}</p>\n      </div>\n\n      <div class=\"p-5 bg-[#121216] border border-neutral-800 rounded-2xl\">\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-2\">_Competências</h2>\n        <p class=\"text-xs text-neutral-400 font-mono\">{{habilidades}}</p>\n      </div>\n\n      <div class=\"p-5 bg-[#121216] border border-neutral-800 rounded-2xl\">\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-1.5\">_Idiomas</h2>\n        <p class=\"text-xs text-neutral-300\">{{idiomas}}</p>\n      </div>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
  "updatedAt": "2026-06-22T00:00:00.000Z"
}