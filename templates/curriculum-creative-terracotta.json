  "content": "<div class=\"max-w-4xl mx-auto bg-[#faf7f2] text-stone-800 shadow-xl rounded-3xl overflow-hidden border border-amber-100 p-8 md:p-12 space-y-10 font-sans\">\n  \n  <!-- Top Header Profile -->\n  <div class=\"flex flex-col md:flex-row justify-between items-start md:items-center border-b border-[#dfd2be] pb-8 gap-6\">\n    <div>\n      <span class=\"text-[10px] font-mono uppercase tracking-[0.25em] text-[#c9623b]\">{{cargo_principal}}</span>\n      <h1 class=\"text-4xl font-extrabold tracking-tight text-stone-900 mt-1 uppercase font-serif\">{{nome_completo}}</h1>\n      <p class=\"text-xs text-stone-500 mt-2 max-w-lg\">\n        Disposta(o) a criar narrativas visuais sólidas e estratégias de conteúdo refinadas que elevam marcas.\n      </p>\n    </div>\n    \n    <div class=\"bg-white p-4 rounded-2xl border border-[#dfd2be]/50 shadow-sm space-y-1 text-[11px] text-right shrink-0 w-full md:w-auto text-left md:text-right\">\n      <div class=\"text-[#c9623b] font-serif font-bold mb-1 border-b border-[#dfd2be]/30 pb-1\">CONTATO DIRECTO</div>\n      <div>📍 {{cidade_estado}}</div>\n      <div>📞 {{telefone}}</div>\n      <div>✉️ {{email}}</div>\n      <div class=\"font-medium text-stone-600\">🔗 {{linkedin}}</div>\n    </div>\n  </div>\n\n  <!-- Two column layout -->\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-10\">\n    <!-- Side column: Overview, Skills & Languages -->\n    <div class=\"md:col-span-1 space-y-8\">\n      \n      <!-- Summary -->\n      <div class=\"space-y-3\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-[#c9623b]\">Minha Essência</h3>\n        <p class=\"text-xs text-stone-600 leading-relaxed text-left text-justify\">\n          {{resumo_profissional}}\n        </p>\n      </div>\n\n      <!-- Creative Skills -->\n      <div class=\"space-y-4\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-[#c9623b]\">Habilidades Criativas</h3>\n        <div class=\"space-y-2 text-xs\">\n          <div>\n            <div class=\"flex justify-between text-[11px] mb-1 font-semibold text-stone-700\">\n              <span>UX Writing & Branding</span>\n              <span class=\"text-[#c9623b]\">90%</span>\n            </div>\n            <div class=\"w-full bg-[#dfd2be]/40 h-1.5 rounded-full\">\n              <div class=\"bg-[#c9623b] h-1.5 rounded-full\" style=\"width: 90%\"></div>\n            </div>\n          </div>\n          <div>\n            <div class=\"flex justify-between text-[11px] mb-1 font-semibold text-stone-700\">\n              <span>Direção de Arte</span>\n              <span class=\"text-[#c9623b]\">85%</span>\n            </div>\n            <div class=\"w-full bg-[#dfd2be]/40 h-1.5 rounded-full\">\n              <div class=\"bg-[#c9623b] h-1.5 rounded-full\" style=\"width: 85%\"></div>\n            </div>\n          </div>\n          <div>\n            <div class=\"flex justify-between text-[11px] mb-1 font-semibold text-stone-700\">\n              <span>Estratégia Digital</span>\n              <span class=\"text-[#c9623b]\">80%</span>\n            </div>\n            <div class=\"w-full bg-[#dfd2be]/40 h-1.5 rounded-full\">\n              <div class=\"bg-[#c9623b] h-1.5 rounded-full\" style=\"width: 80%\"></div>\n            </div>\n          </div>\n        </div>\n        <p class=\"text-[10px] text-stone-500 font-mono italic leading-relaxed mt-1\">\n          Habilidades adicionais: {{habilidades}}\n        </p>\n      </div>\n\n      <!-- Languages -->\n      <div class=\"space-y-2\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-[#c9623b]\">Idiomas</h3>\n        <div class=\"text-xs text-stone-600 space-y-1 font-medium\">\n          {{idiomas}}\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Main column: Experience & Education -->\n    <div class=\"md:col-span-2 space-y-8 \">\n      \n      <!-- Experience section -->\n      <div class=\"space-y-6\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-stone-400 border-b border-[#dfd2be] pb-2\">Trajetória Cronológica</h3>\n        \n        <!-- Exp 1 -->\n        <div class=\"space-y-1.5\">\n          <div class=\"flex justify-between items-baseline\">\n            <h4 class=\"text-sm text-stone-900 font-bold font-serif\">{{experiencia_1_cargo}}</h4>\n            <span class=\"text-[10px] font-mono text-[#c9623b]\">{{experiencia_1_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-[#c9623b] font-semibold italic\">{{experiencia_1_empresa}}</div>\n          <p class=\"text-xs text-stone-600 leading-relaxed text-justify\">\n            {{experiencia_1_descricao}}\n          </p>\n        </div>\n\n        <!-- Exp 2 -->\n        <div class=\"space-y-1.5 pt-2\">\n          <div class=\"flex justify-between items-baseline\">\n            <h4 class=\"text-sm text-stone-900 font-bold font-serif\">{{experiencia_2_cargo}}</h4>\n            <span class=\"text-[10px] font-mono text-stone-500\">{{experiencia_2_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-stone-500 font-semibold italic\">{{experiencia_2_empresa}}</div>\n          <p class=\"text-xs text-stone-600 leading-relaxed text-justify\">\n            {{experiencia_2_descricao}}\n          </p>\n        </div>\n      </div>\n\n      <!-- Academic background -->\n      <div class=\"space-y-4 pt-4 border-t border-[#dfd2be]/60\">\n        <h3 class=\"text-xs font-bold uppercase tracking-widest text-stone-400 border-b border-[#dfd2be] pb-2\">Estudos & Licenças</h3>\n        <div class=\"text-xs\">\n          <div class=\"flex justify-between items-start\">\n            <div>\n              <strong class=\"text-stone-900 font-serif text-[13px]\">{{formacao_1_curso}}</strong>\n              <div class=\"text-stone-500 text-[11px] mt-0.5\">{{formacao_1_instituicao}}</div>\n            </div>\n            <span class=\"text-[10px] font-mono text-stone-500\">{{formacao_1_periodo}}</span>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n</div>\n
