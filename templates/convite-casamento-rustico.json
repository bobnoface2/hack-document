  "content": "<div class=\"p-10 font-sans max-w-xl mx-auto bg-orange-50/70 border-4 border-amber-900/10 rounded-2xl text-amber-950 relative overflow-hidden shadow-xl\">\n  <div class=\"absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-amber-800 via-amber-600 to-amber-900\"></div>\n  \n  <div class=\"text-center space-y-6 relative z-10\">\n    <div class=\"text-4xl\">🌻🌾🌿</div>\n    <p class=\"text-[10px] font-mono tracking-widest text-amber-800 uppercase font-semibold\">Nós decidimos celebrar o amor!</p>\n    \n    <div class=\"py-2\">\n      <h2 class=\"text-3xl font-serif font-black text-amber-900 tracking-tight\">{{nome_casal_1}} & {{nome_casal_2}}</h2>\n    </div>\n\n    <p class=\"text-xs italic text-amber-800 max-w-sm mx-auto\">\n      \"{{frase_amor}}\"\n    </p>\n\n    <div class=\"border-y border-amber-900/20 py-4 my-4 grid grid-cols-2 gap-4 text-center\">\n      <div>\n        <span class=\"block text-[8px] font-mono text-amber-700 uppercase tracking-wider\">No Grande Dia</span>\n        <strong class=\"text-base font-serif text-amber-900\">{{data_feliz}}</strong>\n      </div>\n      <div>\n        <span class=\"block text-[8px] font-mono text-amber-700 uppercase tracking-wider\">Hora do Sim</span>\n        <strong class=\"text-base font-serif text-amber-900\">{{horario_feliz}}</strong>\n      </div>\n    </div>\n\n    <div class=\"bg-amber-900/5 p-4 rounded-xl text-center border border-amber-900/10 space-y-1\">\n      <span class=\"block text-[9px] font-mono text-amber-800 uppercase tracking-widest\">Onde Celebraremos</span>\n      <strong class=\"block text-xs font-serif text-amber-950\">{{sitio_local}}</strong>\n      <p class=\"text-[11px] text-amber-800\">{{endereco_sitio}}</p>\n    </div>\n\n    <div class=\"pt-6 border-t border-amber-900/10 text-center font-sans\">\n      <p class=\"text-[10px] text-amber-700 uppercase font-mono mb-2\">Deixe-nos saber se você vai compartilhar esse dia!</p>\n      <a href=\"{{link_confirmacao}}\" class=\"inline-block bg-amber-800 hover:bg-amber-900 text-white font-bold text-xs uppercase tracking-wider py-2.5 px-6 rounded-lg transition shadow-md\">\n        Confirmar Presença Online ✨\n      </a>\n    </div>\n  </div>\n</div>",
