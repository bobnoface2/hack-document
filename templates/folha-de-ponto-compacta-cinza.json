  "content": "<div class=\"p-4 max-w-4xl mx-auto bg-white text-slate-800 font-sans leading-tight\" style=\"max-height: 29.7cm; box-sizing: border-box;\">\n  <div class=\"text-center border-b border-slate-300 pb-2 mb-2\">\n    <h1 class=\"text-xs font-bold uppercase text-slate-700 tracking-wider\">Registro de Ponto Individual (CLT S/A)</h1>\n    <p class=\"text-[8.5px] uppercase text-slate-500 font-mono mt-0.5\">Mês de Referência: <strong>{{competencia_periodo}}</strong></p>\n  </div>\n\n  <div class=\"grid grid-cols-2 gap-4 text-[9.5px] bg-slate-50 p-2 mb-2 border border-slate-150 rounded\">\n    <div class=\"space-y-0.5\">\n      <p><span class=\"text-slate-500\">Empregador:</span> <strong class=\"text-slate-800\">{{empresa_razao_social}}</strong></p>\n      <p><span class=\"text-slate-500\">CNPJ:</span> <span class=\"font-mono\">{{empresa_cnpj}}</span></p>\n      <p><span class=\"text-slate-500\">Escala de Trabalho:</span> {{escala_trabalho}}</p>\n    </div>\n    <div class=\"space-y-0.5\">\n      <p><span class=\"text-slate-500\">Colaborador:</span> <strong class=\"text-slate-800\">{{nome_colaborador}}</strong></p>\n      <p><span class=\"text-slate-500\">CPF:</span> <span class=\"font-mono\">{{cpf_colaborador}}</span></p>\n      <p><span class=\"text-slate-500\">Função / Cargo:</span> {{cargo_funcao}}</p>\n    </div>\n  </div>\n\n  <table class=\"w-full border-collapse border border-slate-250 text-[8.5px] text-center mb-2.5\">\n    <thead>\n      <tr class=\"bg-slate-205 text-slate-700 font-bold border-b border-slate-300\">\n        <th class=\"border border-slate-200 py-0.5 w-[7%]\">Dia</th>\n        <th class=\"border border-slate-200 py-0.5 w-[11%]\">Manhã Ent.</th>\n        <th class=\"border border-slate-200 py-0.5 w-[11%]\">Manhã Saí.</th>\n        <th class=\"border border-slate-200 py-0.5 w-[11%]\">Tarde Ent.</th>\n        <th class=\"border border-slate-200 py-0.5 w-[11%]\">Tarde Saí.</th>\n        <th class=\"border border-slate-200 py-0.5 w-[11%]\">Ex