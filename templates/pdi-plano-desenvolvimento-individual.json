  "content": "<div class=\"max-w-4xl mx-auto bg-[#fafaf9] text-stone-800 shadow-xl rounded-2xl overflow-hidden border border-slate-200 p-8 md:p-12 space-y-8 font-sans\">\n  \n  <!-- Visual Cover Banner -->\n  <div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center border-b-2 border-indigo-600 pb-6 gap-4\">\n    <div>\n      <span class=\"text-[9px] font-mono uppercase tracking-[0.25em] text-indigo-600 font-bold bg-indigo-50 px-2 py-1 rounded\">Talent Management</span>\n      <h1 class=\"text-2xl font-black text-stone-900 tracking-tight mt-2 uppercase font-serif\">PLANO DE DESENVOLVIMENTO INDIVIDUAL (PDI)</h1>\n      <p class=\"text-xs text-stone-500 mt-1\">Mapeamento de competências, metas e melhorias para avanço profissional de carreira.</p>\n    </div>\n    <div class=\"text-stone-400 font-mono text-[10px] text-left sm:text-right\">\n      PERIODO: {{periodo_ciclo}}\n    </div>\n  </div>\n\n  <!-- Identification block -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 bg-white p-5 rounded-xl border border-slate-100 shadow-sm text-xs\">\n    <div>\n      <span class=\"text-stone-400 font-semibold uppercase tracking-wider block text-[9px] mb-1\">Colaborador em Foco</span>\n      <strong class=\"text-stone-950 block text-[13px] font-bold\">{{colaborador_nome}}</strong>\n      <span class=\"text-stone-500\">Cargo Atual: {{cargo_atual}}</span>\n    </div>\n    <div class=\"border-t md:border-t-0 md:border-l border-slate-100 pt-3 md:pt-0 md:pl-4\">\n      <span class=\"text-stone-400 font-semibold uppercase tracking-wider block text-[9px] mb-1\">Líder / Mentor</span>\n      <strong class=\"text-stone-950 block text-[13px] font-semibold\">{{nome_avaliador}}</strong>\n      <span class=\"text-slate-500\">Objetivo de Carreira: <strong class=\"text-indigo-600 font-medium\">{{objetivo_carreira}}</strong></span>\n    </div>\n  </div>\n\n  <!-- Strengths and Opportunities -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n    <!-- Strengths -->\n    <div class=\"p-5 bg-emerald-50/40 rounded-xl border border-emerald-100/50 space-y-2\">\n      <span class=\"text-emerald-800 font-bold text-[10px] uppercase tracking-wider block\">💪 Pontos Fortes em Destaque</span>\n      <ul class=\"list-disc list-inside text-xs text-stone-650 space-y-1\">\n        <li>{{ponto_forte_1}}</li>\n        <li>{{ponto_forte_2}}</li>\n        <li class=\"text-stone-500\">Forte fit cultural com as diretrizes da empresa</li>\n      </ul>\n    </div>\n\n    <!-- Opportunities -->\n    <div class=\"p-5 bg-amber-50/40 rounded-xl border border-amber-100/50 space-y-2\">\n      <span class=\"text-amber-800 font-bold text-[10px] uppercase tracking-wider block\">🎯 Oportunidades de Melhoria (Foco)</span>\n      <ul class=\"list-disc list-inside text-xs text-stone-650 space-y-1\">\n        <li>{{oportunidade_melhoria_1}}</li>\n        <li>{{oportunidade_melhoria_2}}</li>\n        <li class=\"text-stone-500\">Comunicação ativa e liderança compartilhada</li>\n      </ul>\n    </div>\n  </div>\n\n  <!-- Action Roadmap Table -->\n  <div class=\"space-y-3\">\n    <h3 class=\"text-xs font-bold text-indigo-900 uppercase tracking-widest border-b border-indigo-100 pb-1.5\">Matriz de Metas e Plano de Ação</h3>\n    \n    <div class=\"overflow-x-auto rounded-xl border border-slate-150\">\n      <table class=\"min-w-full divide-y divide-slate-150 text-xs text-stone-700 bg-white\">\n        <thead class=\"bg-slate-50 font-semibold font-mono text-[9px] text-stone-500 uppercase\">\n          <tr>\n            <th class=\"px-4 py-3 text-left\">Meta de Desenvolvimento</th>\n            <th class=\"px-4 py-3 text-left\">Ação & Recursos</th>\n            <th class=\"px-4 py-3 text-left\">Prazo Alvo</th>\n            <th class=\"px-4 py-3 text-center\">Status</th>\n          </tr>\n        </thead>\n        <tbody class=\"divide-y divide-slate-150\">\n          <!-- Meta 1 -->\n          <tr>\n            <td class=\"px-4 py-4 font-bold text-stone-900 border-r border-slate-100 w-1/3\">\n              {{meta_1}}\n            </td>\n            <td class=\"px-4 py-4 text-stone-600 border-r border-slate-100\">\n              Ação Sugerida: <strong class=\"text-stone-800\">{{meta_1_acao}}</strong><br class=\"my-0.5\" />\n              Recursos: {{meta_1_recurso}}\n            </td>\n            <td class=\"px-4 py-4 font-medium font-mono text-stone-500 border-r border-slate-100 whitespace-nowrap\">\n              {{meta_1_prazo}}\n            </td>\n            <td class=\"px-4 py-4 text-center whitespace-nowrap\">\n              <span class=\"inline-block bg-indigo-50 border border-indigo-200 text-indigo-700 rounded-full text-[9px] font-bold px-2 py-0.5 uppercase tracking-wide\">Planejado</span>\n            </td>\n          </tr>\n          <!-- Meta 2 -->\n          <tr>\n            <td class=\"px-4 py-4 font-bold text-stone-900 border-r border-slate-100 w-1/3\">\n              {{meta_2}}\n            </td>\n            <td class=\"px-4 py-4 text-stone-600 border-r border-slate-100\">\n              Ação Sugerida: <strong class=\"text-stone-800\">{{meta_2_acao}}</strong><br class=\"my-0.5\" />\n              Recursos: {{meta_2_recurso}}\n            </td>\n            <td class=\"px-4 py-4 font-medium font-mono text-stone-500 border-r border-slate-100 whitespace-nowrap\">\n              {{meta_2_prazo}}\n            </td>\n            <td class=\"px-4 py-4 text-center whitespace-nowrap\">\n              <span class=\"inline-block bg-slate-100 text-stone-550 border border-slate-200 rounded-full text-[9px] font-bold px-2 py-0.5 uppercase tracking-wide\">A Iniciar</span>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </div> \n\n  <!-- Agreement and Feedbacks -->\n  <div class=\"border-t border-slate-200 pt-6 mt-8 space-y-4\">\n    <h3 class=\"text-xs font-bold text-stone-400 font-mono uppercase tracking-wide\">Assinatura de Acordo de Desenvolvimento</h3>\n    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 text-xs pt-2\">\n      <div class=\"text-center space-y-1\">\n        <div class=\"w-full border-t border-stone-300 pt-2\"></div>\n        <p class=\"font-bold text-stone-900\">{{colaborador_nome}}</p>\n        <p class=\"text-[9px] text-stone-400 font-mono uppercase\">Assinatura do Avaliado</p>\n      </div>\n      <div class=\"text-center space-y-1\">\n        <div class=\"w-full border-t border-stone-300 pt-2\"></div>\n        <p class=\"font-bold text-stone-900\">{{nome_avaliador}}</p>\n        <p class=\"text-[9px] text-stone-400 font-mono uppercase\">Assinatura do Mentor/Líder</p>\n      </div>\n    </div>\n  </div>\n</div>\n",
