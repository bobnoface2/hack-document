  "content": "<div class=\"p-10 max-w-4xl mx-auto bg-[#fbf9f5] text-neutral-850 font-serif leading-relaxed border border-[#ebdccb] rounded-2xl\">\n  <div class=\"flex flex-col items-center text-center pb-6 border-b border-[#ebdec5] mb-6\">\n    <h1 class=\"text-3xl font-black text-[#432d18] uppercase tracking-wide\">{{nome_completo}}</h1>\n    <p class=\"text-xs font-semibold uppercase tracking-widest text-[#7c6347] font-sans mt-2\">{{cargo_principal}}</p>\n    \n    <div class=\"flex flex-wrap lg:justify-center gap-3 text-[11px] font-sans text-neutral-500 mt-4\">\n      <span>📍 {{cidade_estado}}</span>\n      <span>•</span>\n      <span>📞 {{telefone}}</span>\n      <span>•</span>\n      <span>✉️ {{email}}</span>\n      <span>•</span>\n      <span>🔗 {{linkedin}}</span>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\">\n    <div class=\"md:col-span-3 space-y-6\">\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#7c6347] font-sans mb-3 pb-1 border-b border-dashed border-[#ebd2b9]\">Perfil Profissional</h2>\n        <p class=\"text-xs text-neutral-700 leading-relaxed text-justify\">{{resumo_profissional}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#7c6347] font-sans mb-4 pb-1 border-b border-dashed border-[#ebd2b9]\">Experiência Recente</h2>\n        \n        <div class=\"space-y-4\">\n          <div>\n            <div class=\"flex justify-between items-baseline mb-1\">\n              <strong class=\"text-sm text-neutral-900\">{{experiencia_1_cargo}}</strong>\n              <span class=\"text-[10px] font-mono text-[#7c6347] italic font-sans\">{{experiencia_1_periodo}}</span>\n            </div>\n            <p class=\"text-[11px] font-sans font-bold text-[#947754] mb-1.5\">{{experiencia_1_empresa}}</p>\n            <p class=\"text-xs text-neutral-600 leading-relaxed text-justify\">{{experiencia_1_descricao}}</p>\n          </div>\n\n          <div class=\"border-t border-[#ebdccb]/40 pt-4\">\n            <div class=\"flex justify-between items-baseline mb-1\">\n              <strong class=\"text-sm text-neutral-900\">{{experiencia_2_cargo}}</strong>\n              <span class=\"text-[10px] font-mono text-[#7c6347] italic font-sans\">{{experiencia_2_periodo}}</span>\n            </div>\n            <p class=\"text-[11px] font-sans font-bold text-[#947754] mb-1.5\">{{experiencia_2_empresa}}</p>\n            <p class=\"text-xs text-neutral-600 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"space-y-5\">\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#7c6347] font-sans mb-2 pb-1 border-b border-dashed border-[#ebd2b9]\">Educação</h2>\n        <strong class=\"text-xs text-neutral-900 block font-serif\">{{formacao_1_curso}}</strong>\n        <p class=\"text-[10px] font-sans text-neutral-500\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[9px] font-mono text-[#7c6347] mt-0.5\">{{formacao_1_periodo}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#7c6347] font-sans mb-2 pb-1 border-b border-dashed border-[#ebd2b9]\">Habilidades</h2>\n        <p class=\"text-[11px] font-sans text-neutral-600 leading-normal\">{{habilidades}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#7c6347] font-sans mb-1 pb-1 border-b border-dashed border-[#ebd2b9]\">Linguagens</h2>\n        <p class=\"text-xs text-neutral-600 font-sans\">{{idiomas}}</p>\n      </div>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
  "updatedAt": "2026-06-22T00:00:00.000Z"
}