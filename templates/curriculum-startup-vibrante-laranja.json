  "content": "<div class=\"p-8 max-w-4xl mx-auto bg-amber-50/20 text-neutral-800 font-sans leading-relaxed border-t-8 border-orange-500 rounded-3xl overflow-hidden shadow-sm bg-white\">\n  <div class=\"flex flex-col md:flex-row md:justify-between items-start border-b border-orange-100 pb-6 mb-6 gap-4\">\n    <div>\n      <span class=\"px-2.5 py-1 bg-orange-100 text-orange-600 rounded-full text-[9px] font-bold tracking-wider uppercase font-mono\">Hiring S/A Candidate</span>\n      <h1 class=\"text-3xl font-black text-neutral-900 tracking-tight mt-2\">{{nome_completo}}</h1>\n      <p class=\"text-xs font-semibold text-orange-500 uppercase tracking-widest mt-1\">{{cargo_principal}}</p>\n    </div>\n    <div class=\"text-xs font-mono text-neutral-500 bg-neutral-50 p-3 rounded-2xl border border-neutral-100 space-y-1 w-full md:w-auto\">\n      <p>📍 {{cidade_estado}}</p>\n      <p>📱 {{telefone}}</p>\n      <p>✉️ {{email}}</p>\n      <p class=\"text-orange-600\">🔗 <span class=\"underline\">{{linkedin}}</span></p>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n    <div class=\"md:col-span-2 space-y-6\">\n      <div>\n        <h2 class=\"text-xs font-extrabold uppercase tracking-widest text-[#39FF14] bg-neutral-900 px-3 py-1 rounded inline-block mb-3\">Sobre Mim</h2>\n        <p class=\"text-xs text-neutral-600 text-justify leading-relaxed\">{{resumo_profissional}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-extrabold uppercase tracking-widest text-[#39FF14] bg-neutral-900 px-3 py-1 rounded inline-block mb-4\">Experiência</h2>\n        \n        <div class=\"space-y-4\">\n          <div class=\"relative pl-4 border-l border-orange-200\">\n            <div class=\"absolute -left-[4.5px] top-1.5 w-2.5 h-2.5 bg-orange-500 rounded-full\"></div>\n            <div class=\"flex justify-between items-baseline mb-1\">\n              <strong class=\"text-xs text-neutral-900\">{{experiencia_1_cargo}}</strong>\n              <span class=\"text-[9px] font-mono text-orange-600 bg-orange-50 px-2 py-0.5 rounded\">{{experiencia_1_periodo}}</span>\n            </div>\n            <div class=\"text-[10px] text-neutral-500 font-bold mb-1.5\">{{experiencia_1_empresa}}</div>\n            <p class=\"text-xs text-neutral-600 leading-relaxed text-justify\">{{experiencia_1_descricao}}</p>\n          </div>\n\n          <div class=\"relative pl-4 border-l border-orange-200\">\n            <div class=\"absolute -left-[4.5px] top-1.5 w-2.5 h-2.5 bg-orange-500 rounded-full\"></div>\n            <div class=\"flex justify-between items-baseline mb-1\">\n              <strong class=\"text-xs text-neutral-900\">{{experiencia_2_cargo}}</strong>\n              <span class=\"text-[9px] font-mono text-orange-600 bg-orange-50 px-2 py-0.5 rounded\">{{experiencia_2_periodo}}</span>\n            </div>\n            <div class=\"text-[10px] text-neutral-500 font-bold mb-1.5\">{{experiencia_2_empresa}}</div>\n            <p class=\"text-xs text-neutral-600 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"space-y-6\">\n      <div class=\"p-4 bg-orange-50/30 border border-orange-100 rounded-2xl\">\n        <h2 class=\"text-xs font-extrabold uppercase tracking-widest text-[#39FF14] bg-neutral-900 px-2 py-0.5 rounded text-center mb-3\">Formação</h2>\n        <strong class=\"text-xs text-neutral-900 block\">{{formacao_1_curso}}</strong>\n        <p class=\"text-[10px] text-neutral-500\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[9px] text-orange-500 font-mono mt-0.5\">{{formacao_1_periodo}}</p>\n      </div>\n\n      <div class=\"p-4 bg-orange-50/30 border border-orange-100 rounded-2xl\">\n        <h2 class=\"text-xs font-extrabold uppercase tracking-widest text-[#39FF14] bg-neutral-900 px-2 py-0.5 rounded text-center mb-2\">Habilidades</h2>\n        <p class=\"text-[11px] font-mono text-neutral-600leading-snug\">{{habilidades}}</p>\n      </div>\n\n      <div class=\"p-4 bg-orange-50/30 border border-orange-100 rounded-2xl\">\n        <h2 class=\"text-xs font-extrabold uppercase tracking-widest text-[#39FF14] bg-neutral-900 px-2 py-0.5 rounded text-center mb-1\">Idiomas</h2>\n        <p class=\"text-xs text-neutral-600 mt-1\">{{idiomas}}</p>\n      </div>\n    </div>\n  </div>\n</div>",
