  "content": "<div class=\"p-8 font-sans max-w-lg mx-auto bg-slate-950 text-white rounded-2xl border-2 border-indigo-500/40 relative overflow-hidden shadow-2xl\">\n  <div class=\"absolute -top-10 -right-10 w-32 h-32 bg-indigo-500/20 rounded-full blur-2xl\"></div>\n  <div class=\"absolute -bottom-10 -left-10 w-32 h-32 bg-purple-500/20 rounded-full blur-2xl\"></div>\n  \n  <div class=\"text-center relative z-10 space-y-4\">\n    <div class=\"text-5xl animate-bounce\">🚀👩‍🚀✨</div>\n    <p class=\"text-[10px] font-mono tracking-widest text-indigo-400 uppercase\">Missão Espaço S/A</p>\n    <h1 class=\"text-3xl font-black tracking-tight bg-gradient-to-r from-cyan-400 via-indigo-300 to-purple-400 bg-clip-text text-transparent\">\n      Preparem os Capacetes!\n    </h1>\n    <p class=\"text-sm text-gray-300 max-w-md mx-auto leading-relaxed\">\n      A nave espacial do <strong class=\"text-cyan-300\">{{nome_aniversariante}}</strong> está pronta para decolar em direção à constelação dos <strong class=\"text-purple-300\">{{idade}} anos</strong>!\n    </p>\n\n    <div class=\"my-6 border-y border-indigo-500/20 py-4 grid grid-cols-2 gap-4 text-center\">\n      <div class=\"bg-indigo-950/40 p-3 rounded-xl border border-indigo-500/20\">\n        <span class=\"block text-[9px] font-mono text-indigo-400 uppercase\">Data Estelar</span>\n        <strong class=\"text-lg text-white font-bold\">{{data_festa}}</strong>\n      </div>\n      <div class=\"bg-indigo-950/40 p-3 rounded-xl border border-indigo-500/20\">\n        <span class=\"block text-[9px] font-mono text-indigo-400 uppercase\">Lançamento</span>\n        <strong class=\"text-lg text-white font-bold\">{{horario}} hs</strong>\n      </div>\n    </div>\n\n    <div class=\"bg-indigo-950/30 p-4 rounded-xl border border-indigo-500/10 text-center\">\n      <span class=\"block text-[9px] font-mono text-indigo-400 uppercase mb-1\">Base de Lançamento</span>\n      <p class=\"text-xs text-gray-300 font-medium\">{{local_festa}}</p>\n    </div>\n\n    <div class=\"pt-4 text-center\">\n      <p class=\"text-[10px] text-gray-500 uppercase font-mono mb-2\">Confirme sua órbita nas próximas semanas</p>\n      <a href=\"https://wa.me/{{whats_confirmacao}}\" class=\"inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs uppercase tracking-wider py-2.5 px-6 rounded-full shadow-lg transition\">\n        Confirmar Presença 🧑‍🚀\n      </a>\n    </div>\n  </div>\n</div>",
