{
  "id": "curriculum-academico-cientifico",
  "name": "Currículo Acadêmico & Científico (Formal Serif)",
  "type": "documento",
  "category": "recrutamento_selecao",
  "format": "html",
  "content": "<div class=\"p-10 max-w-4xl mx-auto bg-white text-neutral-900 font-serif leading-relaxed\">\n  <div class=\"text-center pb-6 mb-6\">\n    <h1 class=\"text-3xl font-bold uppercase tracking-tight\">{{nome_completo}}</h1>\n    <p class=\"text-xs text-neutral-550 italic font-sans uppercase mt-1\">Currículo Lattes Acadêmico & Profissional</p>\n    <p class=\"text-xs text-neutral-600 font-sans mt-3\">\n      Endereço: {{cidade_estado}} &bull; Celular: {{telefone}}\n    </p>\n    <p class=\"text-xs text-neutral-600 font-sans mt-1\">\n      E-mail: {{email}} &bull; LinkedIn: {{linkedin}}\n    </p>\n  </div>\n\n  <div class=\"space-y-6\">\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-neutral-900 border-b border-neutral-400 pb-0.5 mb-2\">Sumário de Pesquisa</h2>\n      <p class=\"text-xs text-neutral-700 leading-relaxed text-justify indent-4\">{{resumo_profissional}}</p>\n    </div>\n\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-neutral-900 border-b border-neutral-400 pb-0.5 mb-4\">Formação Acadêmica</h2>\n      <div class=\"space-y-3\">\n        <div class=\"flex justify-between items-baseline text-xs\">\n          <strong>{{formacao_1_curso}}</strong>\n          <span class=\"font-sans text-neutral-500 italic\">{{formacao_1_periodo}}</span>\n        </div>\n        <p class=\"text-xs text-neutral-650 -mt-2\">{{formacao_1_instituicao}} &mdash; Concentração principal de estudos e defesa de trabalho.</p>\n      </div>\n    </div>\n\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-neutral-900 border-b border-neutral-400 pb-0.5 mb-3\">Atuação Profissional & Docência</h2>\n      \n      <div class=\"space-y-4\">\n        <div>\n          <div class=\"flex justify-between items-baseline text-xs\">\n            <strong>{{experiencia_1_cargo}}</strong>\n            <span class=\"font-sans text-neutral-500 italic\">{{experiencia_1_periodo}}</span>\n          </div>\n          <p class=\"text-xs font-sans text-neutral-600 mt-0.5 mb-1\">{{experiencia_1_empresa}}</p>\n          <p class=\"text-xs text-neutral-700 text-justify\">{{experiencia_1_descricao}}</p>\n        </div>\n\n        <div class=\"border-t border-neutral-200 pt-3\">\n          <div class=\"flex justify-between items-baseline text-xs\">\n            <strong>{{experiencia_2_cargo}}</strong>\n            <span class=\"font-sans text-neutral-500 italic\">{{experiencia_2_periodo}}</span>\n          </div>\n          <p class=\"text-xs font-sans text-neutral-600 mt-0.5 mb-1\">{{experiencia_2_empresa}}</p>\n          <p class=\"text-xs text-neutral-700 text-justify\">{{experiencia_2_descricao}}</p>\n        </div>\n      </div>\n    </div>\n\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-neutral-900 border-b border-neutral-400 pb-0.5 mb-2\">Áreas de Especialização & Competências</h2>\n      <p class=\"text-xs text-neutral-700\">\n        <strong>Habilidades Metodológicas:</strong> {{habilidades}}<br class=\"my-1\" />\n        <strong>Proficiência em Idiomas:</strong> {{idiomas}}\n      </p>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
  "updatedAt": "2026-06-22T00:00:00.000Z"
}