  "content": "<div class=\"max-w-4xl mx-auto bg-white text-slate-800 shadow-2xl rounded-2xl overflow-hidden border border-slate-100 flex flex-col md:flex-row\">\n  <!-- Left Sidebar (Navy Blue) -->\n  <div class=\"w-full md:w-1/3 bg-[#0d1e3d] text-slate-100 p-8 flex flex-col justify-between\">\n    <div class=\"space-y-8\">\n      <!-- Profile -->\n      <div class=\"text-center md:text-left border-b border-slate-700/60 pb-6\">\n        <div class=\"w-24 h-24 bg-gradient-to-tr from-blue-500 to-indigo-400 rounded-2xl mx-auto md:mx-0 flex items-center justify-center text-4xl shadow-md mb-4 font-bold\">\n          {{iniciais_nome}}\n        </div>\n        <h1 class=\"text-xl font-extrabold tracking-tight text-white uppercase\">{{nome_completo}}</h1>\n        <p class=\"text-xs text-blue-400 font-semibold tracking-wide mt-1 uppercase font-mono\">{{cargo_principal}}</p>\n      </div>\n\n      <!-- Contact Info -->\n      <div class=\"space-y-3 text-xs\">\n        <h3 class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">Contato</h3>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-blue-400\">📍</span>\n          <span>{{cidade_estado}}</span>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-blue-400\">📞</span>\n          <span>{{telefone}}</span>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-blue-400\">✉️</span>\n          <span class=\"truncate\">{{email}}</span>\n        </div>\n        <div class=\"flex items-center gap-2\">\n          <span class=\"text-blue-400\">🔗</span>\n          <span>{{linkedin}}</span>\n        </div>\n      </div>\n\n      <!-- Competencies -->\n      <div class=\"space-y-3\">\n        <h3 class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">Competências</h3>\n        <div class=\"flex flex-wrap gap-1.5\">\n          <span class=\"bg-blue-900/40 text-blue-300 text-[10px] font-mono px-2 py-1 rounded-md border border-blue-800/40\">Liderança</span>\n          <span class=\"bg-blue-900/40 text-blue-300 text-[10px] font-mono px-2 py-1 rounded-md border border-blue-800/40\">Estratégia B2B</span>\n          <span class=\"bg-blue-900/40 text-blue-300 text-[10px] font-mono px-2 py-1 rounded-md border border-blue-800/40\">Gestão ágil</span>\n          <span class=\"bg-blue-900/40 text-blue-300 text-[10px] font-mono px-2 py-1 rounded-md border border-blue-800/40\">OKR & KPIs</span>\n        </div>\n        <p class=\"text-[10px] text-slate-300 leading-relaxed font-sans mt-2\">\n          {{habilidades}}\n        </p>\n      </div>\n\n      <!-- Certifications -->\n      <div class=\"space-y-2 text-xs border-t border-slate-700/40 pt-4\">\n        <h3 class=\"text-[10px] font-bold uppercase tracking-widest text-slate-400\">Idiomas & Extras</h3>\n        <p class=\"text-slate-300 leading-loose\">\n          {{idiomas}}\n        </p>\n      </div>\n    </div>\n\n    <div class=\"text-[9px] text-slate-500 font-mono text-center md:text-left mt-8\">\n      Documento gerado externamente &bull; DocuMestre HR\n    </div>\n  </div>\n\n  <!-- Main Content (White) -->\n  <div class=\"w-full md:w-2/3 p-8 md:p-12 space-y-8 bg-slate-50\">\n    <!-- Profile Summary -->\n    <div class=\"space-y-2.5\">\n      <h2 class=\"text-sm font-extrabold uppercase tracking-wider text-[#0d1e3d] flex items-center gap-1\">\n        <span class=\"inline-block w-2.5 h-1 bg-blue-600 rounded\"></span> Resumo Profissional\n      </h2>\n      <p class=\"text-xs text-slate-600 text-justify leading-relaxed\">\n        {{resumo_profissional}}\n      </p>\n    </div>\n\n    <!-- Professional Practice / Experience -->\n    <div class=\"space-y-4\">\n      <h2 class=\"text-sm font-extrabold uppercase tracking-wider text-[#0d1e3d] flex items-center gap-1\">\n        <span class=\"inline-block w-2.5 h-1 bg-blue-600 rounded\"></span> Experiência Profissional\n      </h2>\n\n      <div class=\"space-y-6 relative border-l border-slate-200 pl-4 ml-1.5\">\n        <!-- Exp 1 -->\n        <div class=\"relative\">\n          <div class=\"absolute -left-[21px] top-1 w-3 h-3 bg-blue-600 border border-white rounded-full\"></div>\n          <div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-1\">\n            <strong class=\"text-sm text-slate-900 font-bold\">{{experiencia_1_cargo}}</strong>\n            <span class=\"text-[10px] font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full border border-blue-100\">{{experiencia_1_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-slate-500 font-semibold mb-2\">{{experiencia_1_empresa}}</div>\n          <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">\n            {{experiencia_1_descricao}}\n          </p>\n        </div>\n\n        <!-- Exp 2 -->\n        <div class=\"relative\">\n          <div class=\"absolute -left-[21px] top-1 w-3 h-3 bg-slate-300 border border-white rounded-full\"></div>\n          <div class=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-1\">\n            <strong class=\"text-sm text-slate-900 font-bold\">{{experiencia_2_cargo}}</strong>\n            <span class=\"text-[10px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full border border-slate-200\">{{experiencia_2_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-slate-500 font-semibold mb-2\">{{experiencia_2_empresa}}</div>\n          <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">\n            {{experiencia_2_descricao}}\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- Education -->\n    <div class=\"space-y-3\">\n      <h2 class=\"text-sm font-extrabold uppercase tracking-wider text-[#0d1e3d] flex items-center gap-1\">\n        <span class=\"inline-block w-2.5 h-1 bg-blue-600 rounded\"></span> Formação Acadêmica\n      </h2>\n\n      <div class=\"space-y-3 text-xs bg-white p-4 rounded-xl border border-slate-100 shadow-sm\">\n        <div class=\"flex justify-between items-start\">\n          <div>\n            <strong class=\"text-slate-950 block font-bold\">{{formacao_1_curso}}</strong>\n            <span class=\"text-slate-500 text-[11px]\">{{formacao_1_instituicao}}</span>\n          </div>\n          <span class=\"text-[10px] font-medium text-slate-400 italic\">{{formacao_1_periodo}}</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
