{
  "id": "nota-fiscal-nfe",
  "name": "Nota Fiscal de Serviços Eletrônica (NFS-e S/A)",
  "type": "recibo",
  "category": "financeiro",
  "format": "html",
  "content": "<div class=\"p-8 font-sans max-w-4xl mx-auto border-2 border-neutral-800 bg-white text-neutral-900 shadow-lg\">\n  <!-- Header table-style -->\n  <div class=\"grid grid-cols-4 border-b-2 border-neutral-800 pb-4 mb-4 items-center gap-4\">\n    <div class=\"col-span-1 border-r border-neutral-300 pr-4 flex flex-col justify-center items-center text-center\">\n      <div class=\"w-12 h-12 bg-neutral-900 text-white rounded-full flex items-center justify-center font-bold text-lg mb-1\">NFS</div>\n      <span class=\"text-[9px] uppercase font-mono text-neutral-500\">Emissora Homologada</span>\n    </div>\n    <div class=\"col-span-2 text-center px-2\">\n      <h1 class=\"text-xl font-bold uppercase tracking-wide\">PREFEITURA MUNICIPAL DE {{prestador_municipio}}</h1>\n      <p class=\"text-xs text-neutral-600 font-medium\">Secretaria Municipal da Fazenda e Planejamento</p>\n      <p class=\"text-[10px] font-mono text-neutral-500 bg-neutral-100 py-0.5 rounded px-2 mt-1 inline-block\">DOCUMENTO AUXILIAR DA NOTA FISCAL DE SERVIÇOS ELETRÔNICA - NFS-e</p>\n    </div>\n    <div class=\"col-span-1 border-l border-neutral-300 pl-4 text-right space-y-1\">\n      <div>\n        <span class=\"text-[9px] font-mono block text-neutral-500\">NÚMERO DA NOTA</span>\n        <span class=\"font-mono font-bold text-sm bg-neutral-100 px-1.5 py-0.5 rounded text-neutral-950\">{{nfe_numero}}</span>\n      </div>\n      <div>\n        <span class=\"text-[9px] font-mono block text-neutral-500\">SÉRIE / CONTROLE</span>\n        <span class=\"font-mono text-xs\">{{nfe_serie}} / {{nfe_cod_autenticidade}}</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Datas de Emissao -->\n  <div class=\"grid grid-cols-3 border border-neutral-300 rounded mb-4 text-[11px] font-mono bg-neutral-50/50\">\n    <div class=\"p-2 border-r border-neutral-300\">\n      <span class=\"block text-[9px] text-neutral-500 uppercase\">Data/Hora de Emissão</span>\n      <span class=\"font-bold text-neutral-900\">{{data_emissao}}</span>\n    </div>\n    <div class=\"p-2 border-r border-neutral-300\">\n      <span class=\"block text-[9px] text-neutral-500 uppercase\">Código de Verificação</span>\n      <span class=\"text-neutral-700 font-bold\">{{verificacao_cod}}</span>\n    </div>\n    <div class=\"p-2\">\n      <span class=\"block text-[9px] text-neutral-500 uppercase\">Regime Especial Tributação</span>\n      <span class=\"text-neutral-700 font-bold\">{{regime_tributario}}</span>\n    </div>\n  </div>\n\n  <!-- Prestador de Servicos -->\n  <div class=\"border border-neutral-300 rounded mb-4 overflow-hidden\">\n    <div class=\"bg-neutral-800 text-white font-mono text-[9px] uppercase tracking-wider px-3 py-1 font-bold\">Prestador do Serviço</div>\n    <div class=\"p-3 text-xs grid grid-cols-3 gap-y-2 gap-x-4\">\n      <div class=\"col-span-2\">\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">RAZÃO SOCIAL / NOME</span>\n        <strong class=\"text-neutral-950\">{{prestador_razao_social}}</strong>\n      </div>\n      <div>\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">CNPJ / CPF</span>\n        <span class=\"font-mono text-neutral-900 font-semibold\">{{prestador_cnpj}}</span>\n      </div>\n      <div class=\"col-span-2\">\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">ENDEREÇO</span>\n        <span class=\"text-neutral-700\">{{prestador_endereco}}</span>\n      </div>\n      <div>\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">INSCRIÇÃO MUNICIPAL / UF</span>\n        <span class=\"font-mono\">{{prestador_im}} / {{prestador_uf}}</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Tomador de Servicos -->\n  <div class=\"border border-neutral-300 rounded mb-4 overflow-hidden\">\n    <div class=\"bg-neutral-100 text-neutral-800 font-mono text-[9px] uppercase tracking-wider px-3 py-1 font-bold border-b border-neutral-300\">Tomador do Serviço</div>\n    <div class=\"p-3 text-xs grid grid-cols-3 gap-y-2 gap-x-4\">\n      <div class=\"col-span-2\">\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">NOME / RAZÃO SOCIAL</span>\n        <strong class=\"text-neutral-950\">{{tomador_razao_social}}</strong>\n      </div>\n      <div>\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">CNPJ / CPF</span>\n        <span class=\"font-mono text-neutral-900 font-semibold\">{{tomador_cnpj}}</span>\n      </div>\n      <div class=\"col-span-2\">\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">ENDEREÇO</span>\n        <span class=\"text-neutral-700\">{{tomador_endereco}}</span>\n      </div>\n      <div>\n        <span class=\"block text-[9px] text-neutral-400 font-mono\">INSCRIÇÃO ESTADUAL / EMAIL</span>\n        <span>{{tomador_email}}</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Discriminacao de Servicos -->\n  <div class=\"border border-neutral-300 rounded mb-4 overflow-hidden\">\n    <div class=\"bg-neutral-800 text-white font-mono text-[9px] uppercase tracking-wider px-3 py-1 font-bold\">Discriminação dos Serviços</div>\n    <div class=\"p-4 text-xs font-mono min-h-[120px] bg-neutral-50/20 leading-relaxed whitespace-pre-wrap text-neutral-800\">\n{{descricao_servicos}}\n    </div>\n  </div>\n\n  <!-- Retencoes de Impostos federais -->\n  <div class=\"border border-neutral-300 rounded mb-4 overflow-hidden\">\n    <div class=\"bg-neutral-100 text-neutral-800 font-mono text-[9px] uppercase tracking-wider px-3 py-1 font-bold border-b border-neutral-300\">Retenções Federais de Impostos</div>\n    <div class=\"grid grid-cols-5 text-center text-xs font-mono\">\n      <div class=\"p-2 border-r border-neutral-300\">\n        <span class=\"block text-[9px] text-neutral-400\">PIS (R$)</span>\n        <span class=\"font-bold\">{{pis_retido}}</span>\n      </div>\n      <div class=\"p-2 border-r border-neutral-300\">\n        <span class=\"block text-[9px] text-neutral-400\">COFINS (R$)</span>\n        <span class=\"font-bold\">{{cofins_retido}}</span>\n      </div>\n      <div class=\"p-2 border-r border-neutral-300\">\n        <span class=\"block text-[9px] text-neutral-400\">CSLL (R$)</span>\n        <span class=\"font-bold\">{{csll_retido}}</span>\n      </div>\n      <div class=\"p-2 border-r border-neutral-300\">\n        <span class=\"block text-[9px] text-neutral-400\">IRRF (R$)</span>\n        <span class=\"font-bold\">{{irrf_retido}}</span>\n      </div>\n      <div class=\"p-2\">\n        <span class=\"block text-[9px] text-neutral-400\">INSS (R$)</span>\n        <span class=\"font-bold\">{{inss_retido}}</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Totais e Dedusoes -->\n  <div class=\"grid grid-cols-4 border border-neutral-300 rounded overflow-hidden text-xs font-mono mb-6 bg-neutral-50/55\">\n    <div class=\"p-2.5 border-r border-neutral-300 col-span-2\">\n      <span class=\"block text-[9px] text-neutral-500 uppercase\">Código de Atividade / CNAE</span>\n      <span class=\"font-bold\">{{cnae_atividade_codigo}}</span>\n    </div>\n    <div class=\"p-2.5 border-r border-neutral-300\">\n      <span class=\"block text-[9px] text-neutral-500 uppercase\">Alíquota ISS (%)</span>\n      <span class=\"font-bold text-neutral-900\">{{iss_aliquota}}%</span>\n    </div>\n    <div class=\"p-2.5\">\n      <span class=\"block text-[9px] text-neutral-500 uppercase\">ISS Retido (R$)</span>\n      <span class=\"font-bold text-neutral-900\">{{iss_valor}}</span>\n    </div>\n  </div>\n\n  <!-- Valores globais da Nota -->\n  <div class=\"grid grid-cols-3 border-2 border-neutral-800 rounded-lg text-center items-center overflow-hidden\">\n    <div class=\"p-3 bg-neutral-50 border-r border-neutral-300\">\n      <span class=\"block text-[10px] text-neutral-500 font-mono uppercase\">Valor Bruto do Serviço</span>\n      <span class=\"text-base font-bold text-neutral-700\">R$ {{valor_bruto}}</span>\n    </div>\n    <div class=\"p-3 bg-neutral-50 border-r border-neutral-300\">\n      <span class=\"block text-[10px] text-neutral-500 font-mono uppercase\">Total Deduções e Retenções</span>\n      <span class=\"text-base font-bold text-red-600\">- R$ {{total_deducoes}}</span>\n    </div>\n    <div class=\"p-3 bg-neutral-900 text-white\">\n      <span class=\"block text-[10px] text-neutral-400 font-mono uppercase\">VALOR LÍQUIDO DA NFS-e</span>\n      <strong class=\"text-lg text-[#39FF14] font-mono\">R$ {{valor_liquido}}</strong>\n    </div>\n  </div>\n\n  <div class=\"mt-8 border-t border-neutral-200 pt-3 text-center text-[10px] text-neutral-400 font-mono select-none\">\n    Este documento foi estruturado digitalmente e assinado por certificação ICP-Brasil S/A sob chaves ICP-{{nfe_cod_autenticidade}}.\n  </div>\n</div>",
  "createdAt": "2026-06-17T00:00:00.000Z",
  "updatedAt": "2026-06-17T00:00:00.000Z"
}
