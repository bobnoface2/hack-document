  "content": "<div class=\"p-8 max-w-4xl mx-auto bg-white text-slate-800 font-sans leading-relaxed border-2 border-emerald-800 rounded-2xl\">\n  <div class=\"flex flex-col md:flex-row justify-between items-center border-b-2 border-emerald-850 pb-5 mb-5\">\n    <div class=\"text-center md:text-left\">\n      <h1 class=\"text-3xl font-bold tracking-tight text-emerald-900 uppercase\">{{nome_completo}}</h1>\n      <p class=\"text-xs font-semibold uppercase tracking-widest text-[#39FF14] bg-slate-900 px-2 py-0.5 rounded inline-block mt-2\">{{cargo_principal}}</p>\n    </div>\n    <div class=\"text-xs text-slate-500 font-mono space-y-0.5 md:text-right mt-4 md:mt-0\">\n      <p>📍 {{cidade_estado}}</p>\n      <p>📞 {{telefone}}</p>\n      <p>✉️ {{email}}</p>\n      <p class=\"text-emerald-700\">🔗 {{linkedin}}</p>\n    </div>\n  </div>\n\n  <div class=\"space-y-6\">\n    <div>\n      <h2 class=\"text-xs font-extrabold uppercase tracking-wider text-emerald-900 border-b-2 border-emerald-800 pb-0.5 mb-2 flex items-center gap-1.5\">🟢 Perfil Profissional</h2>\n      <p class=\"text-xs text-slate-650 leading-relaxed text-justify\">{{resumo_profissional}}</p>\n    </div>\n\n    <div>\n      <h2 class=\"text-xs font-extrabold uppercase tracking-wider text-emerald-900 border-b-2 border-emerald-800 pb-0.5 mb-4 flex items-center gap-1.5\">🟢 Percurso Corporativo</h2>\n      \n      <div class=\"space-y-4\">\n        <div>\n          <div class=\"flex justify-between items-baseline font-bold text-xs text-slate-900\">\n            <span>{{experiencia_1_cargo}}</span>\n            <span class=\"font-mono text-emerald-700 font-medium\">{{experiencia_1_periodo}}</span>\n          </div>\n          <div class=\"text-[10px] text-emerald-600 font-bold mb-1.5\">{{experiencia_1_empresa}}</div>\n          <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">{{experiencia_1_descricao}}</p>\n        </div>\n\n        <div class=\"border-t border-slate-100 pt-3\">\n          <div class=\"flex justify-between items-baseline font-bold text-xs text-slate-900\">\n            <span>{{experiencia_2_cargo}}</span>\n            <span class=\"font-mono text-emerald-700 font-medium\">{{experiencia_2_periodo}}</span>\n          </div>\n          <div class=\"text-[10px] text-emerald-600 font-bold mb-1.5\">{{experiencia_2_empresa}}</div>\n          <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 pt-2\">\n      <div>\n        <h2 class=\"text-xs font-extrabold uppercase tracking-wider text-emerald-900 border-b border-emerald-800 pb-0.5 mb-2\">Educação</h2>\n        <p class=\"text-xs text-slate-900 font-bold\">{{formacao_1_curso}}</p>\n        <p class=\"text-[10px] text-slate-500\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[9px] text-emerald-700 font-medium mt-0.5\">{{formacao_1_periodo}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-extrabold uppercase tracking-wider text-emerald-900 border-b border-emerald-800 pb-0.5 mb-2\">Habilidades</h2>\n        <p class=\"text-[11px] text-slate-600 font-mono\">{{habilidades}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-extrabold uppercase tracking-wider text-emerald-900 border-b border-emerald-800 pb-0.5 mb-2\">Idiomas</h2>\n        <p class=\"text-xs text-slate-600\">{{idiomas}}</p>\n      </div>\n    </div>\n  </div>\n</div>",
  "createdAt": "2026-06-22T00:00:00.000Z",
  "updatedAt": "2026-06-22T00:00:00.000Z"
