  "content": "<div class=\"p-0 max-w-4xl mx-auto bg-[#16161a] text-neutral-150 font-sans leading-relaxed flex flex-col md:flex-row min-h-[750px] border border-neutral-800 rounded-3xl overflow-hidden shadow-xl\">\n  <div class=\"w-full md:w-1/3 bg-red-700 text-white p-6 flex flex-col justify-between\">\n    <div class=\"space-y-6\">\n      <div>\n        <h1 class=\"text-2xl font-black uppercase tracking-tight leading-none mb-1\">{{nome_completo}}</h1>\n        <p class=\"text-[10px] uppercase font-bold tracking-widest text-red-200 mt-2\">{{cargo_principal}}</p>\n      </div>\n      \n      <div class=\"border-t border-red-500 pt-4 space-y-3\">\n        <h2 class=\"text-xs font-bold uppercase tracking-wider text-red-100\">Contato</h2>\n        <ul class=\"space-y-1.5 text-xs text-red-150\">\n          <li>📍 {{cidade_estado}}</li>\n          <li>📞 {{telefone}}</li>\n          <li>✉️ {{email}}</li>\n          <li class=\"truncate\">🔗 {{linkedin}}</li>\n        </ul>\n      </div>\n\n      <div class=\"border-t border-red-500 pt-4 space-y-2\">\n        <h2 class=\"text-xs font-bold uppercase tracking-wider text-red-100\">Educação</h2>\n        <div>\n          <p class=\"text-xs font-bold\">{{formacao_1_curso}}</p>\n          <p class=\"text-[10px] text-red-200\">{{formacao_1_instituicao}}</p>\n          <p class=\"text-[9px] font-mono text-red-100 mt-0.5\">{{formacao_1_periodo}}</p>\n        </div>\n      </div>\n    </div>\n    \n    <div class=\"pt-8 mt-4 border-t border-red-500 text-[10px] leading-tight text-red-200 uppercase tracking-widest font-mono text-center\">\n      HACKDOCUMENT S/A\n    </div>\n  </div>\n\n  <div class=\"w-full md:w-2/3 p-8 flex flex-col justify-between\">\n    <div class=\"space-y-6\">\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-2\">_Resumo Executivo</h2>\n        <p class=\"text-xs text-neutral-300 leading-relaxed text-justify\">{{resumo_profissional}}</p>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-4\">_Histórico Profissional</h2>\n        \n        <div class=\"space-y-4\">\n          <div class=\"border-l border-neutral-750 pl-4\">\n            <div class=\"flex justify-between items-baseline mb-0.5\">\n              <strong class=\"text-xs text-white\">{{experiencia_1_cargo}}</strong>\n              <span class=\"text-[9px] font-mono text-[#39FF14]\">{{experiencia_1_periodo}}</span>\n            </div>\n            <div class=\"text-[10px] text-neutral-450 italic mb-1\">{{experiencia_1_empresa}}</div>\n            <p class=\"text-xs text-neutral-400 leading-relaxed text-justify\">{{experiencia_1_descricao}}</p>\n          </div>\n\n          <div class=\"border-l border-neutral-750 pl-4\">\n            <div class=\"flex justify-between items-baseline mb-0.5\">\n              <strong class=\"text-xs text-white\">{{experiencia_2_cargo}}</strong>\n              <span class=\"text-[9px] font-mono text-[#39FF14]\">{{experiencia_2_periodo}}</span>\n            </div>\n            <div class=\"text-[10px] text-neutral-455 italic mb-1\">{{experiencia_2_empresa}}</div>\n            <p class=\"text-xs text-neutral-400 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n          </div>\n        </div>\n      </div>\n\n      <div>\n        <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] font-mono mb-2\">_Idiomas & Habilidades</h2>\n        <div class=\"grid grid-cols-2 gap-4 text-xs text-neutral-350\">\n          <div>\n            <p class=\"font-bold text-white\">Idiomas:</p>\n            <p>{{idiomas}}</p>\n          </div>\n          <div>\n            <p class=\"font-bold text-white\">Competências:</p>\n            <p class=\"text-[11px] font-mono text-[#39FF14]\">{{habilidades}}</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>",
