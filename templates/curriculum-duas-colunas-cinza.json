  "content": "<div class=\"p-0 max-w-4xl mx-auto bg-white text-slate-800 font-sans leading-relaxed border border-slate-200 rounded-2xl overflow-hidden flex flex-col md:flex-row min-h-[750px]\">\n  <div class=\"w-full md:w-[30%] bg-slate-100 p-6 space-y-6 shrink-0\">\n    <div>\n      <h1 class=\"text-xl font-bold text-slate-900 leading-tight\">{{nome_completo}}</h1>\n      <p class=\"text-xs text-slate-500 font-semibold mt-1 tracking-wide\">{{cargo_principal}}</p>\n    </div>\n    \n    <div class=\"space-y-3\">\n      <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] bg-slate-900 px-2 py-1 rounded text-center\">Contato</h2>\n      <ul class=\"text-[11px] text-slate-600 space-y-2\">\n        <li class=\"flex items-center gap-1.5\">📍 {{cidade_estado}}</li>\n        <li class=\"flex items-center gap-1.5\">📞 {{telefone}}</li>\n        <li class=\"flex items-center gap-1.5\">✉️ {{email}}</li>\n        <li class=\"truncate flex items-center gap-1.5\">🔗 {{linkedin}}</li>\n      </ul>\n    </div>\n\n    <div class=\"space-y-3\">\n      <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] bg-slate-900 px-2 py-1 rounded text-center\">Educação</h2>\n      <div class=\"text-[11px] space-y-1\">\n        <p class=\"font-bold text-slate-900\">{{formacao_1_curso}}</p>\n        <p class=\"text-slate-600\">{{formacao_1_instituicao}}</p>\n        <p class=\"text-[10px] font-mono text-slate-400\">{{formacao_1_periodo}}</p>\n      </div>\n    </div>\n\n    <div class=\"space-y-3\">\n      <h2 class=\"text-xs font-bold uppercase tracking-widest text-[#39FF14] bg-slate-900 px-2 py-1 rounded text-center\">Línguas</h2>\n      <p class=\"text-[11px] text-slate-600 font-medium\">{{idiomas}}</p>\n    </div>\n  </div>\n\n  <div class=\"w-full md:w-[70%] p-8 space-y-6\">\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-1 mb-2.5\">Resumo Profissional</h2>\n      <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">{{resumo_profissional}}</p>\n    </div>\n\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-1 mb-4.5\">Percurso Profissional</h2>\n      \n      <div class=\"space-y-4\">\n        <div>\n          <div class=\"flex justify-between items-baseline mb-1\">\n            <strong class=\"text-xs text-slate-900 font-bold\">{{experiencia_1_cargo}}</strong>\n            <span class=\"text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded\">{{experiencia_1_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-slate-500 font-medium mb-1.5\">{{experiencia_1_empresa}}</div>\n          <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">{{experiencia_1_descricao}}</p>\n        </div>\n\n        <div class=\"border-t border-slate-100 pt-3\">\n          <div class=\"flex justify-between items-baseline mb-1\">\n            <strong class=\"text-xs text-slate-900 font-bold\">{{experiencia_2_cargo}}</strong>\n            <span class=\"text-[10px] font-mono text-slate-400 bg-slate-100 px-1.5 py-0.5 rounded\">{{experiencia_2_periodo}}</span>\n          </div>\n          <div class=\"text-xs text-slate-500 font-medium mb-1.5\">{{experiencia_2_empresa}}</div>\n          <p class=\"text-xs text-slate-600 leading-relaxed text-justify\">{{experiencia_2_descricao}}</p>\n        </div>\n      </div>\n    </div>\n\n    <div>\n      <h2 class=\"text-sm font-bold uppercase tracking-wider text-slate-900 border-b border-slate-200 pb-1 mb-2.5\">Principais Habilidades</h2>\n      <p class=\"text-xs text-slate-600 leading-relaxed font-mono\">{{habilidades}}</p>\n    </div>\n  </div>\n</div>",
